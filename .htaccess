# YoMaNa – Einstellungen für den Apache-Webserver bei manitu

# Eigene Fehlerseite
ErrorDocument 404 /404.html

# Immer https und immer www.yomana.de (passend zu canonical-Links und sitemap.xml).
# Erst aktiv lassen, wenn das SSL-Zertifikat bei manitu für yomana.de UND www.yomana.de eingerichtet ist.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.yomana.de%{REQUEST_URI} [L,R=301]
</IfModule>

# Keine Verzeichnislisten
Options -Indexes

# Zeichensatz
AddDefaultCharset UTF-8

# Sicherheits-Header
<IfModule mod_headers.c>
  # HSTS (nur https) setzt manitu bereits selbst – hier nicht doppelt setzen.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Caching: Bilder und Schriften lange, CSS/JS kurz, HTML immer frisch
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Komprimierung
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
